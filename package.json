{
  "name": "contract-ocr-agent",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=1536 tsx watch src/api/server.ts",
    "build": "tsc",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=1536 node dist/api/server.js",
    "typecheck": "tsc --noEmit",
    "test:ocr": "tsx src/test/ocrTest.ts",
    "test:p3": "tsx src/test/phase3Test.ts",
    "test:p4": "tsx src/test/phase4Test.ts"
  },
  "dependencies": {
    "chromadb": "^1.10.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.0",
    "multer": "^2.0.0",
    "openai": "^5.22.1",
    "pdf-parse": "^1.1.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/pdf-parse": "^1.1.4",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
